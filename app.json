{
  "expo": {
    "name": "CORONAPP",
    "slug": "coronapp",
    "version": "1.0.0",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "CORONAPP necesita acceso a la cámara para escanear códigos de barras.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
